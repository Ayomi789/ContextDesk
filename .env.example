# Copy to apps/api/.env and fill in real values.
# Never commit apps/api/.env.

# API server
PORT=5011
NODE_ENV=development

# Postgres (Neon). Get one free with: npx create-db
DATABASE_URL=postgresql://user:password@host:5432/neondb?sslmode=require

# Auth — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI reply drafts (NVIDIA). Optional locally; required for POST /api/v1/ai-draft
NVIDIA_API_KEY=
# Optional model override (default: openai/gpt-oss-20b)
# NVIDIA_MODEL=

# Google sign-in (OAuth client ID from console.cloud.google.com →
# APIs & Services → Credentials). Optional: unset disables /auth/google.
# The same ID goes in the frontend as VITE_GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_ID=

# Paystack billing (test keys to start). Optional: unset disables checkout.
# Create STARTER + PRO subscription plans in Paystack first.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PLAN_STARTER=
# PAYSTACK_PLAN_PRO=

# Outgoing mail for verification codes. Optional: when unset, codes are
# logged to the server console instead of emailed.
# SMTP_HOST=
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ContextDesk <no-reply@contextdesk.local>

# CORS allowlist for the API, comma-separated.
# Local defaults cover the agon frontend (5515) and Vite default (5173).
# In production set this to your real frontend origin(s).
FRONTEND_URL=http://localhost:5515,http://localhost:5173
